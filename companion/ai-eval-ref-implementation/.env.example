# Environment Configuration
#
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# Microsoft Foundry project endpoint
# Format: https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=

# Azure OpenAI endpoint (for local evaluation with azure-ai-evaluation SDK)
# Format: https://<account>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# Model deployment name for evaluation judge
EVALUATION_MODEL=gpt-4o

# Agent configuration
AGENT_NAME=Contoso-Support-Agent
AGENT_VERSION=1

# Agent model deployment name (for agent creation)
AZURE_AI_AGENT_MODEL=gpt-4o
